{
    "name": "pulsar-chain-client",
    "version": "1.0.0",
    "private": true,
    "description": "Shared pulsar-chain gRPC client: grpc-js clients and codecs generated from the pulsar-chain submodule protos, wire-format parsers, validator-set queries",
    "type": "module",
    "main": "build/src/index.js",
    "types": "build/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/src/index.d.ts",
            "default": "./build/src/index.js"
        },
        "./messages": {
            "types": "./build/src/messages.d.ts",
            "default": "./build/src/messages.js"
        }
    },
    "scripts": {
        "build": "buf generate && tsc",
        "test": "vitest run",
        "proto:gen": "buf generate",
        "clean": "rimraf build coverage node_modules"
    },
    "keywords": [
        "pulsar"
    ],
    "license": "MIT",
    "dependencies": {
        "@bufbuild/protobuf": "^2.13.0",
        "@grpc/grpc-js": "^1.14.4",
        "o1js": "2.15.0"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.71.0",
        "@types/node": "^24.13.2",
        "rimraf": "^6.1.3",
        "ts-proto": "2.12.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9"
    }
}
