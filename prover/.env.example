# Smoke test needs only Mongo + Pulsar gRPC. Fill the rest for full stack.

# Redis (full stack only)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# MongoDB
MONGO_URI="mongodb://127.0.0.1:27017"
MONGO_DB="pulsar"
MONGO_USER=""
MONGO_PASSWORD=""

# Mina (settle flow — not needed for smoke)
MINA_PRIVATE_KEY=""
MINA_NETWORK="lightnet"
MINA_FEE=""

CONTRACT_PRIVATE_KEY=""
CONTRACT_ADDRESS=""

# Pulsar chain — local testnet node #1. Public endpoints on :443 get TLS
# automatically (e.g. grpc.pulsarchain.xyz:443).
PULSAR_GRPC_ENDPOINT="127.0.0.1:9090"
PULSAR_RPC_ENDPOINT="127.0.0.1:26657"
PULSAR_CHAIN_ID="pulsar-local"

# Height the first proven 8-block epoch starts at (min 2; anchor = this - 1).
# Leave unset for a fresh chain. Against a long-running chain set it near the
# current height or the prover replays the whole history. FROZEN at seed time:
# changing it later needs `pnpm run reset` + contract redeploy.
EPOCH_START_HEIGHT=""
PULSAR_PRIVATE_KEY_HEX=""
PULSAR_FEE_AMOUNT=""
PULSAR_FEE_DENOM="upulsar"
PULSAR_GAS_LIMIT=""
MERKLE_WITNESS=""

REMOTE_SERVER_URL=""
