{
    "name": "pulsar-prover",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "pnpm --filter pulsar-contracts --filter pulsar-chain-client build && tsc",
        "start": "pnpm run build && node dist/src/nodeManager.js",
        "worker:block-prover": "pnpm run build && node --max-old-space-size=8192 dist/src/workers/block-prover/index.js",
        "worker:aggregator": "pnpm run build && node --max-old-space-size=8192 dist/src/workers/aggregator/index.js",
        "worker:settlement-prover": "pnpm run build && node --max-old-space-size=8192 dist/src/workers/settlement-prover/index.js",
        "worker:settler": "pnpm run build && node --max-old-space-size=8192 dist/src/workers/settler/index.js",
        "cli": "pnpm run build && node dist/src/cli.js",
        "deploy": "pnpm run build && node dist/src/scripts/deploy.js",
        "seed": "pnpm run build && node dist/src/scripts/seed.js",
        "smoke": "pnpm run build && node --max-old-space-size=8192 dist/src/scripts/smokeTest.js",
        "gap": "pnpm run build && node dist/src/scripts/gap.js",
        "doctor": "pnpm run build && node dist/src/scripts/doctor.js",
        "reset": "pnpm run build && node dist/src/scripts/reset.js",
        "clean": "rimraf dist coverage node_modules"
    },
    "keywords": [
        "pulsar"
    ],
    "author": "",
    "license": "MIT",
    "description": "",
    "dependencies": {
        "@grpc/grpc-js": "^1.14.4",
        "@o1js/native": "^2.15.0",
        "@types/inquirer": "^9.0.10",
        "bullmq": "^5.79.2",
        "dotenv": "^17.4.2",
        "inquirer": "^12.11.1",
        "ioredis": "5.10.1",
        "mongodb": "^6.21.0",
        "mongoose": "^9.7.3",
        "node-fetch": "^3.3.2",
        "o1js": "2.15.0",
        "pulsar-chain-client": "workspace:*",
        "pulsar-contracts": "workspace:*",
        "rimraf": "^6.1.3",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9"
    },
    "peerDependencies": {
        "o1js": "2.15.0"
    },
    "private": true
}
