{
    "name": "pulsar-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm run build:deps && concurrently -k -n next,worker -c cyan,magenta \"next dev\" \"pnpm run dev:worker\"",
        "dev:next": "pnpm run build:deps && next dev",
        "dev:worker": "mkdir -p dev-assets && wrangler dev --assets dev-assets --var DEV_ORIGIN:http://localhost:3000",
        "build": "pnpm run build:deps && next build",
        "build:deps": "pnpm --filter pulsar-contracts --filter pulsar-chain-client build",
        "cache:build": "pnpm run build:deps && node scripts/generate-cache.mjs",
        "preview": "pnpm run build && wrangler dev",
        "deploy": "pnpm run build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "lint": "next lint",
        "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
    },
    "dependencies": {
        "@chain-registry/types": "^2.0.250",
        "@cosmjs/amino": "^0.36.2",
        "@cosmjs/encoding": "^0.36.2",
        "@cosmjs/proto-signing": "^0.36.2",
        "@cosmjs/stargate": "^0.36.2",
        "@interchain-kit/core": "^0.3.42",
        "@interchain-kit/keplr-extension": "^0.3.42",
        "@interchain-kit/leap-extension": "^0.3.42",
        "@interchain-kit/react": "^0.3.42",
        "@interchainjs/cosmos": "^1.12.1",
        "@tailwindcss/postcss": "^4.0.0",
        "@tanstack/react-query": "^5.83.0",
        "bs58": "^6.0.0",
        "chain-registry": "^2.0.29",
        "clsx": "^2.1.1",
        "comlink": "^4.4.2",
        "cosmjs-types": "^0.10.1",
        "motion": "^13.1.0",
        "next": "15.5.23",
        "o1js": "2.15.0",
        "pulsar-chain-client": "workspace:*",
        "pulsar-contracts": "workspace:*",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.5.2",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "concurrently": "^10.0.4",
        "eslint": "^9.18.0",
        "eslint-config-next": "^15.1.4",
        "postcss": "^8.5.26",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.2",
        "wrangler": "^4.122.0"
    }
}
