{
  // The Worker runs on workerd, not in a browser: its Request/Response/fetch
  // are Cloudflare's, and its `fetch` init accepts a `cf` object the DOM lib
  // knows nothing about. Checking it under the app's DOM types would either
  // reject valid code or accept browser-only APIs that do not exist there.
  //
  // Both the runtime types and the Env bindings come from
  // ../worker-configuration.d.ts, which `pnpm cf-typegen` regenerates from
  // wrangler.jsonc.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "../worker-configuration.d.ts"]
}
