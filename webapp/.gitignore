# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler
.wrangler

.open-next

# next dev builds here; next build (static export) uses .next
.next-dev/

# Generated by `pnpm cf-typegen` from wrangler.jsonc — regenerate locally
# instead of tracking it.
worker-configuration.d.ts

# Empty on purpose: `wrangler dev` serves static assets before invoking the
# Worker, so an empty directory keeps it from shadowing the Next dev server.
dev-assets/

# Generated by `pnpm cache:build` — 40 MB of o1js compilation artifacts,
# rebuilt from the circuits rather than tracked.
public/cache/
