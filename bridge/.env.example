# MongoDB — circuit-breaker bookkeeping (BridgeState) plus the signed-root
# archive (SignedRoot): vote-extension signatures survive one block on-chain,
# so the archive is the only durable record the quorum proof can target.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=pulsar-bridge

# Redis (BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mina
MINA_NETWORK=lightnet              # lightnet | devnet | mainnet
MINA_PRIVATE_KEY=                  # base58 private key for the bridge signing account
MINA_FEE=100000000                 # 0.1 MINA in nanomina
CONTRACT_ADDRESS=                  # Deployed SettlementContract address (base58)

# Pulsar chain gRPC — REQUIRED, the single chain dependency: validator set
# with powers, vote-extension bodies + signatures for the quorum proof, the
# chain-adjudicated verdict leaves and the cumulative approval root the walk
# verifies against the contract's approvalCursor. Without a real chain the
# bridge cannot reduce at all.
PULSAR_GRPC_ENDPOINT=localhost:9090

# Ordered validator set as JSON for environments WITHOUT a Pulsar chain
# (lightnet). Hash-gated against the contract's merkleListRoot, so a wrong
# set fails fast instead of proving.
# VALIDATOR_SET_OVERRIDE=[{"minaPublicKey":"B62...","power":"1"},...]

# Bridge config
MAX_RETRY=3                        # non-transient strikes per queue front before the master halts

# Optional
NODE_ENV=production
LOG_LEVEL=info
