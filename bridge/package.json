{
    "name": "pulsar-bridge",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "pnpm --filter pulsar-contracts --filter pulsar-chain-client build && tsc",
        "start": "pnpm run build && node --max-old-space-size=8192 dist/src/index.js",
        "doctor": "pnpm run build && node dist/src/scripts/doctor.js",
        "clean": "rimraf dist node_modules"
    },
    "keywords": [
        "pulsar"
    ],
    "author": "",
    "license": "MIT",
    "description": "",
    "dependencies": {
        "@cosmjs/crypto": "^0.36.2",
        "@cosmjs/encoding": "^0.36.2",
        "@cosmjs/proto-signing": "^0.36.2",
        "@cosmjs/stargate": "^0.36.2",
        "@grpc/grpc-js": "^1.14.4",
        "@t3-oss/env-core": "^0.13.11",
        "bullmq": "^5.79.2",
        "cosmjs-types": "^0.10.1",
        "dotenv": "^17.4.2",
        "ioredis": "5.10.1",
        "mongoose": "^9.7.3",
        "o1js": "2.15.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "pulsar-chain-client": "workspace:*",
        "pulsar-contracts": "workspace:*",
        "rimraf": "^6.1.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9"
    },
    "private": true
}
