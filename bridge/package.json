{
    "name": "pulsar-bridge",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --config vitest.integration.config.ts",
        "test:e2e": "node --max-old-space-size=8192 ../contracts/build/src/scripts/e2e-reduce-test.js",
        "build": "pnpm --filter pulsar-contracts --filter pulsar-chain-client build && tsc",
        "start": "pnpm run build && node dist/src/nodeManager.js",
        "worker:bridge-tx-sender": "pnpm run build && node dist/src/workers/bridge-tx-sender/index.js",
        "clean": "rimraf dist node_modules"
    },
    "keywords": [
        "pulsar"
    ],
    "author": "",
    "license": "MIT",
    "description": "",
    "dependencies": {
        "@cosmjs/crypto": "^0.36.0",
        "@cosmjs/encoding": "^0.36.0",
        "@cosmjs/proto-signing": "^0.36.0",
        "@cosmjs/stargate": "^0.36.0",
        "@grpc/grpc-js": "^1.13.4",
        "bullmq": "^5.58.5",
        "cosmjs-types": "^0.10.1",
        "dotenv": "^17.2.2",
        "ioredis": "5.10.1",
        "mongoose": "^9.1.6",
        "o1js": "2.10.0-dev.be63f",
        "pulsar-contracts": "workspace:*",
        "rimraf": "^6.0.1",
        "winston": "^3.17.0",
        "pulsar-chain-client": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.3.1",
        "typescript": "^5.9.2",
        "vitest": "^4.1.8"
    },
    "private": true
}
